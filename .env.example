# ==============================================================================
# Light For Volunteer — environment template
# Copy to `.env` at the repo root (or apps/api/.env for local API-only work).
# NEVER commit real values.
# ==============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3001

# --- Frontend origin (CORS + OAuth redirect base) ----------------------------
WEB_ORIGIN=http://localhost:3000
# Public build-time frontend setting; include the API prefix, e.g. https://api.example.org/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# --- PostgreSQL --------------------------------------------------------------
# Host port 5433 — a native Windows PostgreSQL service often owns 5432.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=lfv
DATABASE_PASSWORD=lfv
DATABASE_NAME=light_for_volunteer
DATABASE_SYNC=false
DATABASE_MIGRATIONS_RUN=false

# --- Redis (refresh sessions, exchange codes, rate limits) -------------------
# Leave empty to fall back to the Postgres refresh-token column (single session).
REDIS_URL=redis://localhost:6379

# --- JWT ---------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_TTL_SECONDS=604800
# Seconds an already-rotated refresh token stays replayable (multi-tab grace)
REFRESH_GRACE_SECONDS=60

# --- Google OAuth 2.0 --------------------------------------------------------
# Authorized redirect URI: {API_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# --- Rate limiting (per-route overrides; global policy is owned by infra) ----
THROTTLE_AUTH_TTL=60
THROTTLE_AUTH_LIMIT=10

# --- Admin bootstrap (used by `npm run seed:admin`; leave blank to skip) -----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin

STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_REGION=auto
R2_BUCKET_NAME=light-for-volunteer
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
